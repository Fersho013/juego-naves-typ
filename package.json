{
  "name": "juego-nave-meteoritos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Juego de nave estilo Echelon ULTRA — Vite + TypeScript + Canvas",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
